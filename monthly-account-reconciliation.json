      "parameters": {
        "jsCode": "const txt = ($input.first().json.text) || ($input.first().json.data) || '';\nconst promptText = 'Extract all transactions from this bank statement text. Return ONLY a JSON array where each element is {\"date\":\"YYYY-MM-DD\",\"description\":\"...\",\"amount\":<number>,\"balance\":<number>}. Amounts must be numbers (negative for debits). No prose, no markdown.\\n\\nSTATEMENT TEXT:\\n' + txt;\nreturn [{ json: { requestBody: { model: 'claude-3-5-sonnet-20241022', max_tokens: 4096, messages: [{ role: 'user', content: promptText }] } } }];"
      },
