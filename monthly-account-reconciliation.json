      "parameters": {
        "jsCode": "function toNum(v) {\n  if (typeof v === 'number') return v;\n  if (v === null || v === undefined || v === '') return 0;\n  const s = String(v).replace(/[^0-9.\\-]/g, '');\n  const n = parseFloat(s);\n  return isNaN(n) ? 0 : n;\n}\nfunction toDate(v) {\n  if (v === null || v === undefined || v === '') return '';\n  const d = new Date(v);\n  if (!isNaN(d.getTime())) return d.toISOString().slice(0, 10);\n  return String(v).trim();\n}\nconst ledger = $('Read Ledger').all().map(i => ({\n  date: toDate(i.json.date),\n  amount: toNum(i.json.amount),\n  description: (i.json.description || '').toString().trim(),\n  reference: (i.json.reference || '').toString().trim(),\n  source: 'ledger',\n}));\nconst bank = $input.all()\n  .map(i => i.json)\n  .filter(r => r && (r.date || r.amount !== undefined && r.amount !== null))\n  .map(r => ({\n    date: toDate(r.date),\n    amount: toNum(r.amount),\n    description: (r.description || '').toString().trim(),\n    reference: '',\n    source: 'bank',\n  }));\nreturn ledger.concat(bank).map(r => ({ json: r }));"
      },
