    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet text = '';\nif (items.length && items[0].json && items[0].json.content) {\n  const blocks = items[0].json.content;\n  const b = Array.isArray(blocks) ? blocks.find(x => x.type === 'text') : null;\n  text = b ? b.text : '';\n}\nlet arr = [];\nif (text) {\n  let clean = text.trim();\n  const fence = String.fromCharCode(96, 96, 96);\n  clean = clean.split(fence).join('');\n  if (clean.slice(0, 4).toLowerCase() === 'json') clean = clean.slice(4);\n  clean = clean.trim();\n  try { arr = JSON.parse(clean); } catch (e) { arr = []; }\n}\nif (!Array.isArray(arr)) arr = [];\nif (arr.length === 0) return [{ json: {} }];\nreturn arr.map(t => ({ json: { date: t.date, description: t.description, amount: t.amount, balance: t.balance } }));"
      },
      "id": "e6e2ba07-4d76-4c61-9727-9019c5410741",
      "name": "Parse Bank PDF JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        240
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const all = $input.all().map(i => i.json);\nconst ledger = all.filter(r => r.source === 'ledger');\nconst bank = all.filter(r => r.source === 'bank');\nconst usedBank = {};\nconst matched = [];\nconst unmatchedLedger = [];\nfor (const L of ledger) {\n  let hit = -1;\n  for (let j = 0; j < bank.length; j++) {\n    if (usedBank[j]) continue;\n    if (bank[j].date === L.date && Math.round(bank[j].amount * 100) === Math.round(L.amount * 100)) { hit = j; break; }\n  }\n  if (hit >= 0) { usedBank[hit] = true; matched.push({ ledger: L, bank: bank[hit] }); }\n  else unmatchedLedger.push(L);\n}\nconst unmatchedBank = bank.filter((_, j) => !usedBank[j]);\nreturn [{ json: {\n  totalLedger: ledger.length,\n  totalBank: bank.length,\n  exactMatchedCount: matched.length,\n  matched,\n  unmatchedLedger,\n  unmatchedBank,\n} }];"
      },
      "id": "033b7af3-42a5-4336-a363-e5c0047b50aa",
      "name": "Exact Match",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        144
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst promptText = [\n  'You are a bank reconciliation assistant.',\n  'Compare these UNMATCHED ledger and bank transactions and identify likely matches despite: date shifts of 1-3 days, rounding differences under a small tolerance (< 0.05), or differently worded descriptions that refer to the same transaction.',\n  'Ledger entries (JSON): ' + JSON.stringify(d.unmatchedLedger || []),\n  'Bank entries (JSON): ' + JSON.stringify(d.unmatchedBank || []),\n  'Return ONLY a JSON array. Each element must be {\"ledger\": <the ledger object>, \"bank\": <the bank object>, \"confidence\": <number 0-100>, \"reason\": \"<short reason>\"}. If there are no plausible matches, return []. No prose, no markdown.',\n].join('\\n');\nreturn [{ json: {\n  unmatchedLedger: d.unmatchedLedger || [],\n  unmatchedBank: d.unmatchedBank || [],\n  requestBody: { model: 'claude-3-5-sonnet-20241022', max_tokens: 4096, messages: [{ role: 'user', content: promptText }] },\n} }];"
      },
      "id": "f606673a-bcca-41b6-85b5-4ecb29b0c9e0",
      "name": "Build Fuzzy Prompt",
