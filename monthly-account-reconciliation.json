    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet text = '';\nif (items.length && items[0].json && items[0].json.content) {\n  const blocks = items[0].json.content;\n  const b = Array.isArray(blocks) ? blocks.find(x => x.type === 'text') : null;\n  text = b ? b.text : '';\n}\nlet arr = [];\nif (text) {\n  let clean = text.trim();\n  const fence = String.fromCharCode(96, 96, 96);\n  clean = clean.split(fence).join('');\n  if (clean.slice(0, 4).toLowerCase() === 'json') clean = clean.slice(4);\n  clean = clean.trim();\n  try { arr = JSON.parse(clean); } catch (e) { arr = []; }\n}\nif (!Array.isArray(arr)) arr = [];\nif (arr.length === 0) return [{ json: { pairType: 'none' } }];\nreturn arr.map(p => ({ json: {\n  pairType: 'candidate',\n  confidence: Number(p.confidence) || 0,\n  reason: p.reason || '',\n  ledger: p.ledger || {},\n  bank: p.bank || {},\n} }));"
      },
