      "id": "49bdd0fc-9feb-456f-bf98-8acc760c1d0d",
      "name": "Build Report Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        4032,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst L = [];\nL.push('MONTHLY ACCOUNT RECONCILIATION REPORT');\nL.push('Generated: ' + (r.generatedAt || ''));\nL.push('');\nL.push('SUMMARY');\nL.push('Total ledger entries: ' + r.totalLedger);\nL.push('Total bank entries: ' + r.totalBank);\nL.push('Matched exactly: ' + r.matchedExact);\nL.push('Matched via fuzzy logic: ' + r.matchedFuzzy);\nL.push('True discrepancies: ' + r.discrepancyCount);\nL.push('Match rate: ' + r.matchRate + '%');\nL.push('');\nL.push('DISCREPANCIES');\nconst disc = r.discrepancies || [];\nif (disc.length === 0) {\n  L.push('None - all entries reconciled.');\n} else {\n  L.push('Date | Amount | Description | Source | Reason');\n  L.push('---- | ------ | ----------- | ------ | ------');\n  for (const d of disc) {\n    const hasLedger = d.ledger && d.ledger.date;\n    const e = hasLedger ? d.ledger : (d.bank || {});\n    const src = hasLedger ? 'ledger' : 'bank';\n    L.push([e.date || '', (e.amount !== undefined && e.amount !== null) ? e.amount : '', (e.description || ''), src, (d.reason || '')].join(' | '));\n  }\n}\nconst title = 'Reconciliation Report ' + String(r.generatedAt || '').slice(0, 10);\nreturn [{ json: { docBody: L.join('\\n'), docTitle: title } }];"
      },
