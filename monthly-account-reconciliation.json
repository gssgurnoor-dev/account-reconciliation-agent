      "id": "7eaf4172-233b-4156-9b30-abe7d20e1b84",
      "name": "Mark Discrepancy",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        3360,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "const ex = $('Exact Match').first().json;\nconst classified = $input.all().map(i => i.json).filter(r => r.pairType === 'candidate');\nconst fuzzyMatched = classified.filter(r => Number(r.confidence) > 85);\nconst discrepancies = classified.filter(r => !(Number(r.confidence) > 85));\nconst totalMatched = ex.exactMatchedCount + fuzzyMatched.length;\nconst denom = Math.max(ex.totalLedger, 1);\nconst matchRate = Math.round((totalMatched / denom) * 1000) / 10;\nconst discList = discrepancies.map(d => ({\n  ledger: d.ledger || {},\n  bank: d.bank || {},\n  confidence: Number(d.confidence) || 0,\n  reason: d.reason || 'No confident match found',\n}));\nreturn [{ json: {\n  totalLedger: ex.totalLedger,\n  totalBank: ex.totalBank,\n  matchedExact: ex.exactMatchedCount,\n  matchedFuzzy: fuzzyMatched.length,\n  discrepancyCount: discList.length,\n  matchRate: matchRate,\n  discrepancies: discList,\n  generatedAt: $now.toISO(),\n} }];"
      },
